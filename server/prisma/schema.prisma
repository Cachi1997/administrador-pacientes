generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Patient {
  id        String   @id @default(uuid())
  name      String
  caretaker String
  email     String
  date      DateTime @db.Date
  symptoms  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("patients")
}